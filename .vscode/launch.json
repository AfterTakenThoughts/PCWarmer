    "version": "0.2.0",
    "configurations": [
        {
            "name": "PCWarmer Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-desktopgl-debug",
            "program": "${workspaceFolder}/PCWarmer/PCWarmer/PCWarmer.DesktopGL/bin/Debug/net8.0/PCWarmer.dll",
            "args": [],
            "cwd": "${workspaceFolder}/PCWarmer/PCWarmer/PCWarmer.DesktopGL/bin/Debug/net8.0/",
            "console": "internalConsole",
            "stopAtEntry": false,
            "justMyCode": true
        },
        {
            "name": "PCWarmer Release",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-desktopgl-release",
            "program": "${workspaceFolder}/PCWarmer/PCWarmer/PCWarmer.DesktopGL/bin/Release/net8.0/PCWarmer.dll",
            "args": [],
            "cwd": "${workspaceFolder}/PCWarmer/PCWarmer/PCWarmer.DesktopGL/bin/Release/net8.0/",
            "console": "internalConsole",
            "stopAtEntry": false,
            "justMyCode": false
        }
    ]
}
